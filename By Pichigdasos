            if parte:IsA("BasePart") and parte:IsDescendantOf(workspace) then
                local tipo=parte:GetAttribute("Tipo") or parte.Name
                if not estaDesbloqueada(tipo) then continue end
                local mult=CintaCfg.Multiplicadores[tipo] or 0
                if preferida and tipo:lower()==preferida:lower() then return parte end
                if mult>mejorMult then mejorMult=mult; mejorParte=parte end
            end
        end
