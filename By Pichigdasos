    local function getParteCinta(preferido)
        local mejor=nil; local mejorMulti=-1
        for _,parte in CollectionService:GetTagged("Treadmill") do
            if parte:IsA("BasePart") and parte:IsDescendantOf(workspace) then
                local tipo = parte:GetAttribute("Type") or parte.Name
                if not isCintaDesbloqueada(tipo) then continue end
                local multi = TreadmillCfg.Multis[tipo] or 0
                if preferido and tipo:lower()==preferido:lower() then return parte end
                if not preferido then
                    if multi > mejorMulti then mejorMulti=multi; mejor=parte end
                end
            end
        end
        if mejor then return mejor end
        for _,parte in CollectionService:GetTagged("Treadmill") do
            if parte:IsA("BasePart") and parte:IsDescendantOf(workspace) then
                local tipo = parte:GetAttribute("Type") or parte.Name
                if isCintaDesbloqueada(tipo) then return parte end
            end
        end
