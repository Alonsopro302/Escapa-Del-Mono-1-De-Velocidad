            local pos=PosGanarFija[mundoOriginal][etapa]
            local mejorParte=nil; local mejorDist=80
            for _,v in workspace:GetDescendants() do
                if v:IsA("BasePart") and v.BrickColor.Name=="New Yeller" and v.Name=="Button" then
                    local d=(v.Position - pos).Magnitude
                    if d < mejorDist then mejorDist=d; mejorParte=v end
                end
            end
            if mejorParte then
                return {parte=mejorParte, mundo=mundo, etapa=etapa, victorias=MainCfg.StageWins[mundoOriginal][etapa] or 0, modelo=mejorParte.Parent}
            else
                return {parte={CFrame=CFrame.new(pos), Position=pos, BrickColor={Name="New Yeller"}, Name="Button", GetFullName=function() return "Fijo:"..mundo..etapa end}, mundo=mundo, etapa=etapa, victorias=MainCfg.StageWins[mundoOriginal][etapa] or 0, esFijo=true}
            end
        end
        for _,e in obtenerTodasGanarNormales(mundo) do
            if e.mundo==mundo and e.etapa==etapa then return e end
        end
        return nil
    end

