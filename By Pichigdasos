    local function mejorAccesibleSinComprar()
        local mejor=nil local reqMax=-1
        for ind,conf in ipairs(UpgradesCfg) do
            if conf and conf.RequisitoVictorias and not Data.MejorasDesbloqueadas:FindFirstChild(tostring(ind)) then
                if NumerosGrandes.MayorIgual(Data.Victorias, conf.RequisitoVictorias) and conf.RequisitoVictorias>reqMax then reqMax=conf.RequisitoVictorias mejor=ind end
