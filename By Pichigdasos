        local function habilitarAntiPausa()
            pcall(function() if redPausada then redPausada:Disconnect() end end)
            redPausada = COREGUI.RobloxGui.ChildAdded:Connect(function(obj)
                if obj.Name == "CoreScripts/NetworkPause" then
                    pcall(function() obj:Destroy() end)
                end
            end)
            pcall(function()
                local existente=COREGUI.RobloxGui:FindFirstChild("CoreScripts/NetworkPause") or COREGUI.RobloxGui:FindFirstChild("NetworkPause")
                if existente then existente:Destroy() end
                local cs=COREGUI.RobloxGui:FindFirstChild("CoreScripts")
                if cs and cs:FindFirstChild("NetworkPause") then cs.NetworkPause:Destroy() end
            end)
        end
        habilitarAntiPausa()
        task.spawn(function()
            while true do
                task.wait(5)
                pcall(function()
                    local np=COREGUI.RobloxGui:FindFirstChild("CoreScripts/NetworkPause")
                    if np then np:Destroy() end
                end)
            end
        end)
        pcall(function()
            if _G.addcmd or getgenv().addcmd then
                local addcmd = _G.addcmd or getgenv().addcmd
                addcmd("antipausajuego", {}, function(args, speaker)
