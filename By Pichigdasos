-- Funciones auxiliares
local function dispararSeguro(remoto,...)
    if not remoto then return false end
    local ok, err
    local clase = remoto.ClassName
    if clase=="RemoteEvent" then ok,err = pcall(function(...) remoto:FireServer(...) end, ...)
    elseif clase=="RemoteFunction" then ok,err = pcall(function(...) return remoto:InvokeServer(...) end, ...)
    else ok,err = pcall(function(...) remoto:FireServer(...) end, ...) end
    if not ok then warn("[Fallo al enviar] "..tostring(remoto.Name)..": "..tostring(err)) end
    return ok
end

local function crearControlIntervalo(grupo,id,texto,defecto)
    return grupo:AgregarDeslizador(id, {Texto=texto, Defecto=defecto or 0.5, Mínimo=0.01, Máximo=10, Redondeo=2, Sufijo="s"})
end

local Bucles={}
local function iniciarBucle(id,conmutador,intervalo,funcion)
    if Bucles[id] then task.cancel(Bucles[id]); Bucles[id]=nil end
    Bucles[id]=task.spawn(function()
        while Toggles[conmutador] and Toggles[conmutador].Valor do
            local ok,err=pcall(funcion)
            if not ok then warn("["..id.."] Error →",err) end
            local espera = 0.5
            if Options[intervalo] then espera=Options[intervalo].Valor end
            task.wait(espera)
        end
        Bucles[id]=nil
    end)
end

local function detenerBucle(id) if Bucles[id] then task.cancel(Bucles[id]); Bucles[id]=nil end end

