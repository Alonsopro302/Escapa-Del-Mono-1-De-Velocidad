                local selRemoto = mapaRarezas[sel] or "Rare"
                if Remotes:FindFirstChild("DeleteCharms") then safeFire(Remotes.DeleteCharms, selRemoto) end
            end)
        else stopLoop("AutoEliminarAmuletos") end
    end)

    Toggles.AutoFusionarAmuletos:OnChanged(function()
        if Toggles.AutoFusionarAmuletos.Value then
            runLoop("AutoFusionarAmuletos","AutoFusionarAmuletos","AutoFusionarAmuletos_Intervalo",function()
                local carpetaAmuletos = Data:FindFirstChild("Charms")
                if not carpetaAmuletos then return end
                local porClave={}
                for _,c in ipairs(carpetaAmuletos:GetChildren()) do
                    local nombreAmuleto = c:GetAttribute("CharmName") or c:GetAttribute("Name") or ""
                    if nombreAmuleto=="" then continue end
                    if c:GetAttribute("Locked") then continue end
                    local valEstrella = c:GetAttribute("Stars")
                    if type(valEstrella)~="number" then valEstrella=0 end
                    if valEstrella >= 3 then continue end
                    local k = nombreAmuleto.."_"..tostring(valEstrella)
                    porClave[k] = porClave[k] or {}
                    table.insert(porClave[k], c.Name)
                end
                for k, ids in pairs(porClave) do
                    if #ids >= 3 then
                        local aFusionar={ids[1], ids[2], ids[3]}
                        if Remotes:FindFirstChild("FuseCharms") then safeFire(Remotes.FuseCharms, aFusionar) end
                        return
                    end
                end
            end)
        else stopLoop("AutoFusionarAmuletos") end
    end)
end

