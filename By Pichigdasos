                    local pos = PosGanarFija[mundoOriginal] and PosGanarFija[mundoOriginal][entradaObjetivo.etapa] or entradaObjetivo.parte.Position
                    hrp.CFrame = CFrame.new(pos + Vector3.new(0,5,0))
                    local mejorParte=nil; local mejorDist=80
                    for _,v in workspace:GetDescendants() do
                        if v:IsA("BasePart") and v.BrickColor.Name=="New Yeller" and v.Name=="Button" then
                            local d=(v.Position - pos).Magnitude
                            if d < mejorDist then mejorDist=d; mejorParte=v end
                        end
                    end
                    if mejorParte then
                        pcall(function() firetouchinterest(hrp, mejorParte, 0) task.wait(0.1) firetouchinterest(hrp, mejorParte, 1) end)
                    else
                        pcall(function() firetouchinterest(hrp, entradaObjetivo.parte, 0) task.wait(0.1) firetouchinterest(hrp, entradaObjetivo.parte, 1) end)
                    end
                else
                    hrp.CFrame = entradaObjetivo.parte.CFrame + Vector3.new(0,3,0)
                    pcall(function()
                        firetouchinterest(hrp, entradaObjetivo.parte, 0)
                        task.wait(0.1)
