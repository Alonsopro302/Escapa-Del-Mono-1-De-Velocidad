    local function getMejorAccesibleBloqueada()
        local BN=nil
        pcall(function() BN=require(game.ReplicatedStorage.Util.BigNum) end)
        if not BN then BN=BigNum end
        local mejor=nil; local mejorReq=-1
        for idx,cfg in ipairs(UpgradesCfg) do
            local req=cfg and cfg.WinsRequirement
            if cfg and not Data.UnlockedUpgrades:FindFirstChild(tostring(idx)) and req then
                local accesible=false
                if BN and BN.GreaterEqual then
                    accesible=BN.GreaterEqual(Data.Wins, req)
                else
                    accesible=BigNum.GreaterEqual(Data.Wins, req)
                end
                if accesible and req > mejorReq then mejorReq=req; mejor=idx end
            end
        end
        return mejor
    end

    local function getMejorAccesible()
        local mejor=Data.SelectedUpgrade.Value
        local mejorReq=-1
        for idx,cfg in ipairs(UpgradesCfg) do
            if cfg and cfg.WinsRequirement and BigNum.GreaterEqual(Data.Wins, cfg.WinsRequirement) then
                if cfg.WinsRequirement > mejorReq then mejorReq=cfg.WinsRequirement; mejor=idx end
            end
        end
        return mejor
    end

